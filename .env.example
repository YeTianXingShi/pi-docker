# ==============================================================================
# Pi Docker 客户端环境变量配置模版 (Windows & macOS)
# 复制本文件为 .env：cp .env.example .env
# ==============================================================================

# 远端云服务器 IP 或 Hostname (如果在 ~/.ssh/config 中配置了别名，也可以填别名)
SSH_HOST=1.2.3.4
SSH_USER=root
SSH_PORT=22

# SSH 登录凭据 (私钥路径自动展开 ~，Windows 与 macOS 均支持)
SSH_KEY=~/.ssh/id_rsa
# SSH_PASSWORD=your_password  # 若无私钥，可使用密码认证

# 远端服务器上 server 目录所在的路径
REMOTE_PI_DIR=/root/pi-docker/server

# 本地自动转发的端口范围区间或列表 (默认 36601-36699)
PORT_RANGE=36601-36699
