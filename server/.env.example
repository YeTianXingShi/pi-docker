# ==============================================================================
# Pi Docker 服务端环境变量配置模版 (Linux Docker 运行环境)
# 复制本文件为 .env：cp .env.example .env
# ==============================================================================

# 运行用户与家目录设置 (云服务器 root 用户)
DOCKER_USER=0:0
CONTAINER_HOME=/root

# 容器调试端口范围区间 (仅绑定服务器本地 127.0.0.1 回环地址)
PORT_RANGE=36601-36699

# 网络代理 (如果服务器访问外网需要代理，按需开启)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
